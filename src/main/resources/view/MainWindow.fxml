<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<AnchorPane prefHeight="600.0"
            prefWidth="400.0"
            stylesheets="@../css/main.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="luckynoslacky.luckyui.gui.MainWindow">
    <children>
        <HBox fx:id="brandHeader"
              id="brandHeader"
              alignment="CENTER_LEFT"
              spacing="12.0"
              prefHeight="86.0"
              maxHeight="86.0"
              styleClass="brand-header"
              AnchorPane.topAnchor="0.0"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0">
            <children>
                <ImageView fx:id="brandAvatar"
                           id="brandAvatar"
                           fitWidth="56.0"
                           fitHeight="56.0"
                           preserveRatio="true"
                           styleClass="brand-avatar">
                    <clip>
                        <Circle centerX="28.0" centerY="28.0" radius="28.0" />
                    </clip>
                </ImageView>

                <VBox alignment="CENTER_LEFT"
                      spacing="0.0"
                      HBox.hgrow="ALWAYS">
                    <Label fx:id="brandTitle"
                           id="brandTitle"
                           text="LuckyNoSlacky"
                           styleClass="brand-title" />
                    <Label fx:id="brandTagline"
                           id="brandTagline"
                           text="Your lucky task buddy"
                           wrapText="true"
                           styleClass="brand-tagline" />
                </VBox>

                <Label id="brandAccent"
                       text="🍀"
                       styleClass="brand-accent" />
            </children>
        </HBox>

        <ScrollPane fx:id="scrollPane"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    prefHeight="557.0"
                    prefWidth="400.0"
                    AnchorPane.topAnchor="86.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0"
                    AnchorPane.bottomAnchor="57.0">
            <content>
                <VBox fx:id="dialogContainer"
                      id="dialogContainer"
                      spacing="10.0"
                      fillWidth="true"
                      styleClass="dialog-container" />
            </content>
        </ScrollPane>

        <HBox spacing="8.0"
              AnchorPane.leftAnchor="8.0"
              AnchorPane.rightAnchor="8.0"
              AnchorPane.bottomAnchor="8.0">
            <TextField fx:id="userInput"
                       id="userInput"
                       prefHeight="41.0"
                       promptText="Enter command..."
                       onAction="#handleUserInput"
                       HBox.hgrow="ALWAYS" />

            <Button id="sendButton"
                    text="Send"
                    prefHeight="41.0"
                    prefWidth="70.0"
                    onAction="#handleUserInput" />
        </HBox>
    </children>
</AnchorPane>
