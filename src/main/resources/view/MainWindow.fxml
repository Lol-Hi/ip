<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0"
            prefWidth="400.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="luckynoslacky.luckyui.gui.MainWindow">
    <children>
        <ScrollPane fx:id="scrollPane"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    prefHeight="557.0"
                    prefWidth="400.0"
                    AnchorPane.topAnchor="0.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0"
                    AnchorPane.bottomAnchor="43.0">
            <content>
                <VBox fx:id="dialogContainer"
                      id="dialogContainer"
                      spacing="10.0"
                      fillWidth="true"
                      style="-fx-padding: 10px;" />
            </content>
        </ScrollPane>

        <TextField fx:id="userInput"
                   id="userInput"
                   prefHeight="41.0"
                   promptText="Enter command..."
                   onAction="#handleUserInput"
                   AnchorPane.leftAnchor="1.0"
                   AnchorPane.rightAnchor="76.0"
                   AnchorPane.bottomAnchor="1.0" />

        <Button id="sendButton"
                text="Send"
                prefHeight="41.0"
                prefWidth="70.0"
                onAction="#handleUserInput"
                AnchorPane.rightAnchor="1.0"
                AnchorPane.bottomAnchor="1.0" />
    </children>
</AnchorPane>
